# Supabase (local values are printed by `pnpm supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the scheduled alert job and seed scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used in emails and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only this email may sign up (single-user app). Leave empty to allow any email in local dev.
ALLOWED_EMAIL=

# Scheduled alerts
# Shared secret that pg_cron / Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me
RESEND_API_KEY=
# Use onboarding@resend.dev until you verify your own domain in Resend
ALERT_EMAIL_FROM=Stowly <onboarding@resend.dev>

# Web push (generate with `pnpm vapid`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Barcode lookup (optional overrides; defaults are the public Open Food Facts / Open Products Facts APIs)
# PRODUCT_LOOKUP_FOOD_URL=https://world.openfoodfacts.org
# PRODUCT_LOOKUP_PRODUCTS_URL=https://world.openproductsfacts.org
